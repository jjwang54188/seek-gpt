---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];
type RelatedPost = Pick<CollectionEntry<'blog'>, 'id' | 'data'>;

const { title, description, pubDate, updatedDate, heroImage, tags = [], relatedPosts = [], searchable = true } = Astro.props as Props & { relatedPosts?: RelatedPost[]; searchable?: boolean };
const heroImageSrc = heroImage && (typeof heroImage === 'string' ? heroImage : heroImage.src);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(1120px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 2.5rem 0 4rem;
			}

			article {
				display: grid;
				gap: 2rem;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 0 0 1rem;
				padding: 0;
				list-style: none;
			}

			.tags a {
				display: inline-block;
				padding: 0.2rem 0.55rem;
				border: 1px solid rgba(124, 211, 255, 0.3);
				border-radius: 4px;
				color: rgba(241, 245, 249, 0.82);
				font-size: 0.86rem;
				line-height: 1.4;
				text-decoration: none;
			}

			.tags a:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			.related {
				width: min(760px, 100%);
				margin: 0 auto;
				padding-top: 1.75rem;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
			}

			.related ul {
				display: grid;
				gap: 0.75rem;
				margin: 1rem 0 0;
				padding: 0;
				list-style: none;
			}

			.related a {
				color: rgba(241, 245, 249, 0.88);
			}

			.hero-image {
				width: 100%;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px;
				object-fit: cover;
				min-height: 280px;
			}

			.prose {
				width: min(760px, 100%);
				margin: 0 auto;
				padding: 0;
			}

			.title {
				margin-bottom: 2rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}

			.title h1 {
				margin: 0.4rem 0 1rem;
			}

			.title p {
				margin: 0;
				color: rgba(241, 245, 249, 0.68);
			}

			.date {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				font-size: 0.95rem;
				color: rgba(241, 245, 249, 0.58);
			}

			.last-updated-on {
				font-style: normal;
			}

			@media (max-width: 720px) {
				main {
					width: min(1120px, calc(100% - 1.25rem));
					padding-top: 1.5rem;
				}

				.hero-image img {
					min-height: 220px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article data-pagefind-body={searchable ? true : undefined}>
				<div class="hero-image">
					{heroImageSrc && <img width="1020" height="510" src={heroImageSrc} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && <div class="last-updated-on">更新于 <FormattedDate date={updatedDate} /></div>
							}
						</div>
						<h1>{title}</h1>
						<p>{description}</p>
					</div>
					{tags.length > 0 && (
						<ul class="tags" aria-label="文章标签">
							{tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}
						</ul>
					)}
					<slot />
				</div>
			</article>
			{
				relatedPosts.length > 0 && (
					<section class="related" aria-label="相关推荐">
						<h2>继续阅读</h2>
						<ul>
							{relatedPosts.map((relatedPost) => <li><a href={`/blog/${relatedPost.id}/`}>{relatedPost.data.title}</a></li>)}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
