---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const heroImageSrc = heroImage && (typeof heroImage === 'string' ? heroImage : heroImage.src);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(1120px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 2.5rem 0 4rem;
			}

			article {
				display: grid;
				gap: 2rem;
			}

			.hero-image {
				width: 100%;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px;
				object-fit: cover;
				min-height: 280px;
			}

			.prose {
				width: min(760px, 100%);
				margin: 0 auto;
				padding: 0;
			}

			.title {
				margin-bottom: 2rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}

			.title h1 {
				margin: 0.4rem 0 1rem;
			}

			.title p {
				margin: 0;
				color: rgba(241, 245, 249, 0.68);
			}

			.date {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				font-size: 0.95rem;
				color: rgba(241, 245, 249, 0.58);
			}

			.last-updated-on {
				font-style: normal;
			}

			@media (max-width: 720px) {
				main {
					width: min(1120px, calc(100% - 1.25rem));
					padding-top: 1.5rem;
				}

				.hero-image img {
					min-height: 220px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImageSrc && <img width="1020" height="510" src={heroImageSrc} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && <div class="last-updated-on">更新于 <FormattedDate date={updatedDate} /></div>
							}
						</div>
						<h1>{title}</h1>
						<p>{description}</p>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
