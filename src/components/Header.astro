---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="brand"><a class="brand-mark" href="/" aria-label="首页">S</a><a class="brand-name" href="/">{SITE_TITLE}</a></div>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/search">搜索</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header { position: sticky; top: 0;
		z-index: 10;
		padding: .8rem 1rem;
		background: transparent;
		backdrop-filter: blur(18px);
		border-bottom: 0;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.brand a { font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: rgb(var(--white));
		text-decoration: none;
	}

	.brand-mark { display:grid; place-items:center; width:2.1rem; height:2.1rem; border-radius:.75rem; color:white !important; background:linear-gradient(135deg,#f97316,#ec4899 55%,#7c3aed); }
	.brand-name { margin-left:.6rem; }

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1120px;
		margin: 0 auto;
		min-height: 3.2rem; padding:.45rem .7rem; border:1px solid rgba(15,23,42,.1); border-radius:1.15rem; background:rgba(255,255,255,.78); box-shadow:0 8px 24px rgba(15,23,42,.08);
		gap: 1rem;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	nav a {
		padding: 0.55rem 0.75rem;
		color: rgba(30, 41, 59, 0.82);
		border-radius:.7rem;
		text-decoration: none;
	}

	nav a.active {
		background:rgba(59,130,246,.1);
		color: rgb(var(--white));
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}

		nav {
			min-height: 3rem;
		}

		.brand {
			gap: 0.6rem;
		}

		.brand span {
			display: none;
		}

		.internal-links {
			gap: 0;
		}

		nav a {
			padding-left: 0.55rem;
			padding-right: 0.55rem;
			font-size: 0.95rem;
		}
	}
</style>
