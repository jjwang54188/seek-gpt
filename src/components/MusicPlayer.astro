<button id="music-player-toggle" class="btn-plain scale-animation rounded-lg h-11 px-3 md:px-5 font-bold gap-1 active:scale-90" aria-label="音乐" aria-controls="music-player-panel" aria-expanded="false" type="button">
  <span aria-hidden="true">♫</span><span>音乐</span>
</button>
<div id="music-player-panel" class="music-player-panel float-panel float-panel-closed" role="dialog" aria-label="站内音乐播放器">
  <div class="music-player-title"><strong>站内音乐</strong><button id="music-player-close" type="button" aria-label="关闭音乐播放器">×</button></div>
  <p class="music-player-hint">选择你电脑或手机上的音乐文件，音乐只在本站播放器中播放，不会跳转到其他平台。</p>
  <input id="music-files" type="file" accept="audio/*" multiple aria-label="选择音乐文件">
  <div id="music-track">还没有选择音乐</div>
  <audio id="music-audio" controls preload="metadata"></audio>
  <div class="music-player-actions"><button id="music-prev" type="button">上一首</button><button id="music-next" type="button">下一首</button><button id="music-clear" type="button">清空</button></div>
</div>

<style>
  .music-player-panel{position:absolute;right:1rem;top:4.75rem;width:min(340px,calc(100vw - 2rem));z-index:100;padding:1rem;background:var(--float-panel-bg);border:1px solid rgb(120 140 160 / .15);box-shadow:0 14px 38px rgb(30 50 80 / .15)}
  .music-player-title{display:flex;justify-content:space-between;align-items:center;color:var(--primary);font-size:1.05rem}.music-player-title button{border:0;background:none;font-size:1.5rem;color:inherit;cursor:pointer}.music-player-hint{font-size:.78rem;line-height:1.5;color:var(--text-50);margin:.65rem 0}.music-player-panel input{width:100%;font-size:.8rem}.music-player-panel audio{width:100%;margin:.7rem 0}.music-player-actions{display:flex;gap:.4rem}.music-player-actions button{border:0;border-radius:999px;background:var(--btn-regular-bg);color:var(--btn-content);padding:.4rem .7rem;cursor:pointer;font-size:.75rem}.music-player-actions button:hover{background:var(--btn-regular-bg-hover)}#music-track{font-size:.8rem;margin-top:.7rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
</style>

<script>
  const toggle = document.getElementById('music-player-toggle');
  const panel = document.getElementById('music-player-panel');
  const close = document.getElementById('music-player-close');
  const files = document.querySelector<HTMLInputElement>('#music-files');
  const audio = document.querySelector<HTMLAudioElement>('#music-audio');
  const track = document.getElementById('music-track');
  const playlist: {name:string;url:string}[] = [];
  if (toggle && panel && files && audio && track) {
  let current = 0;
  const open = () => { panel?.classList.remove('float-panel-closed'); toggle?.setAttribute('aria-expanded','true'); };
  const hide = () => { panel?.classList.add('float-panel-closed'); toggle?.setAttribute('aria-expanded','false'); };
  const load = (index: number, autoplay = false) => { if (!playlist.length) return; current=(index+playlist.length)%playlist.length; audio.src=playlist[current].url; track.textContent=playlist[current].name; if(autoplay) audio.play().catch(()=>{track.textContent=playlist[current].name+' · 请点击播放按钮重试';}); };
  const clear = () => { audio.pause(); audio.removeAttribute('src'); audio.load(); playlist.forEach(item=>URL.revokeObjectURL(item.url)); playlist.splice(0); track.textContent='还没有选择音乐'; files.value=''; };
  toggle?.addEventListener('click', () => panel?.classList.contains('float-panel-closed') ? open() : hide());
  close?.addEventListener('click', hide);
  files.addEventListener('change', () => { const selected=Array.from(files.files || []); if(!selected.length)return; clear(); selected.forEach(file => playlist.push({name:file.name,url:URL.createObjectURL(file)})); load(0); open(); });
  document.getElementById('music-prev')?.addEventListener('click', () => load(current-1,true));
  document.getElementById('music-next')?.addEventListener('click', () => load(current+1,true));
  document.getElementById('music-clear')?.addEventListener('click', clear);
  document.addEventListener('keydown',event=>{if(event.key==='Escape')hide();});
  audio?.addEventListener('ended', () => load(current+1,true));
  }
</script>
