---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`搜索 | ${SITE_TITLE}`} description="搜索 Seek 博客中的全部文章。" />
		<style>
			main { width: min(880px, calc(100% - 2rem)); }
			header + main { padding-top: 2.25rem; }
			form { display: flex; gap: 0.75rem; margin: 1.5rem 0; }
			input { flex: 1; min-width: 0; padding: 0.7rem 0.85rem; border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 4px; color: rgb(var(--white)); background: rgba(15, 23, 42, 0.72); }
			button { padding: 0.7rem 1rem; border: 1px solid var(--accent); border-radius: 4px; color: #06111a; background: var(--accent); cursor: pointer; font: inherit; }
			#status { color: rgba(241, 245, 249, 0.62); }
			#results { display: grid; gap: 1.1rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
			#results :global(li) { padding-bottom: 1.1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
			#results :global(a) { color: rgb(var(--white)); font-size: 1.2rem; font-weight: 700; }
			#results :global(p) { margin: 0.45rem 0 0; color: rgba(241, 245, 249, 0.68); }
			mark { padding: 0; color: inherit; background: rgba(124, 211, 255, 0.32); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>搜索文章</h1>
			<p>输入标题、正文或标签中的关键词。</p>
			<form id="search-form">
				<label class="sr-only" for="query">搜索关键词</label>
				<input id="query" name="query" type="search" placeholder="例如：Astro、部署、写作" autocomplete="off" />
				<button type="submit">搜索</button>
			</form>
			<p id="status" role="status">输入关键词开始搜索。</p>
			<ul id="results"></ul>
		</main>
		<Footer />
		<script is:inline type="module">
			const form = document.querySelector('#search-form');
			const input = document.querySelector('#query');
			const status = document.querySelector('#status');
			const results = document.querySelector('#results');
			let requestId = 0;

			function textFromHtml(html) {
				const template = document.createElement('template');
				template.innerHTML = html;
				return template.content.textContent || '';
			}

			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const currentRequest = ++requestId;
				const query = input?.value.trim() || '';
				results?.replaceChildren();
				if (!query) {
					status.textContent = '请输入要搜索的关键词。';
					return;
				}
				status.textContent = '正在搜索...';
				try {
					const pagefind = await import('/pagefind/pagefind.js');
					await pagefind.init();
					const search = await pagefind.search(query);
					const matches = await Promise.all(search.results.slice(0, 20).map((result) => result.data()));
					if (currentRequest !== requestId) return;
					status.textContent = `找到 ${search.results.length} 篇相关文章。`;
					for (const match of matches) {
						const item = document.createElement('li');
						const link = document.createElement('a');
						link.href = match.url;
						link.textContent = match.meta.title || '未命名文章';
						const excerpt = document.createElement('p');
						excerpt.textContent = textFromHtml(match.excerpt);
						item.append(link, excerpt);
						results?.append(item);
					}
				} catch {
					if (currentRequest !== requestId) return;
					status.textContent = '搜索加载失败，请检查网络后重新搜索，或前往文章页面浏览。';
				}
			});
		</script>
	</body>
</html>
