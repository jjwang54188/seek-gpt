---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_INTRO, SITE_TITLE } from '../consts';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts[0];
const latest = posts.slice(1);
---
<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="home-shell">
			<aside class="profile-card">
				<div class="avatar">S</div>
				<p class="profile-kicker">PERSONAL BLOG</p><h1>{SITE_TITLE}</h1>
				<p class="profile-intro">{SITE_INTRO}</p>
				<nav class="profile-links" aria-label="站点导航"><a href="/blog">文章</a><a href="/about">关于</a><a href="/search">搜索</a></nav>
				<div class="profile-note">记录前端、部署和持续学习。</div>
			</aside>
			<section class="feed" aria-labelledby="latest-heading">
				<div class="feed-heading"><div><p class="eyebrow">WELCOME</p><h2 id="latest-heading">最近文章</h2></div><a href="/blog">查看全部 →</a></div>
			{featured && <a class="featured-card" href={`/blog/${featured.id}/`}><img src={typeof featured.data.heroImage === 'string' ? featured.data.heroImage : featured.data.heroImage?.src} alt="" /><div class="featured-copy"><span class="post-date">{featured.data.pubDate.toLocaleDateString('zh-CN')}</span><h3>{featured.data.title}</h3><p>{featured.data.description}</p><span class="read-more">阅读全文 →</span></div></a>}
			<div class="post-list">{latest.map((post) => <a class="post-row" href={`/blog/${post.id}/`}><img src={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src} alt="" /><div><span class="post-date">{post.data.pubDate.toLocaleDateString('zh-CN')}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="arrow">→</span></a>)}</div>
			<div class="home-footer"><p>{SITE_DESCRIPTION}</p><a href="/rss.xml">订阅 RSS</a></div>
		</section>
		</main><Footer />
	</body>
</html>
<style>
	.home-shell{display:grid;grid-template-columns:260px minmax(0,1fr);gap:4rem;width:min(1120px,calc(100% - 2rem));padding-top:3.5rem}.profile-card{position:sticky;top:6rem;align-self:start;padding:1.5rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(20,28,48,.72);box-shadow:0 18px 50px rgba(0,0,0,.18)}.avatar{display:grid;place-items:center;width:72px;height:72px;margin-bottom:1.2rem;border-radius:22px;color:#fff;font-size:2rem;font-weight:700;background:linear-gradient(135deg,#f97316,#ec4899 55%,#7c3aed)}.profile-kicker,.eyebrow{margin:0 0 .55rem;color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.16em}.profile-card h1{font-size:1.65rem}.profile-intro{color:rgb(var(--muted));font-size:.95rem;line-height:1.65}.profile-links{display:flex;gap:.4rem;margin:1.5rem 0;flex-wrap:wrap}.profile-links a{padding:.35rem .7rem;border-radius:8px;background:rgba(124,211,255,.1);text-decoration:none;font-size:.9rem}.profile-note{padding-top:1rem;border-top:1px solid rgba(255,255,255,.08);color:rgb(var(--muted));font-size:.82rem}.feed-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:1rem}.feed-heading h2{margin:0;font-size:2.1rem}.feed-heading a{text-decoration:none;font-size:.9rem}.featured-card,.post-row{display:grid;grid-template-columns:180px minmax(0,1fr);gap:1.25rem;padding:1rem;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:rgba(20,28,48,.52);text-decoration:none;color:inherit;transition:transform .2s,border-color .2s}.featured-card:hover,.post-row:hover{transform:translateY(-3px);border-color:rgba(124,211,255,.6)}.featured-card img,.post-row img{width:100%;height:100%;min-height:150px;object-fit:cover;border-radius:11px}.post-date{color:rgb(var(--muted));font-size:.8rem}.featured-copy h3,.post-row h3{margin:.35rem 0 .5rem;font-size:1.25rem}.featured-copy p,.post-row p{margin:0;color:rgb(var(--muted));font-size:.92rem;line-height:1.6}.read-more{display:inline-block;margin-top:1rem;color:var(--accent);font-size:.85rem}.post-list{display:grid;gap:.8rem;margin-top:.8rem}.post-row{grid-template-columns:100px minmax(0,1fr) auto;padding:.8rem;align-items:center}.post-row img{min-height:82px}.post-row h3{font-size:1.05rem}.post-row p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.arrow{padding:0 .5rem;color:var(--accent);font-size:1.3rem}.home-footer{display:flex;justify-content:space-between;gap:1rem;margin-top:1.5rem;padding:1rem .2rem;color:rgb(var(--muted));font-size:.85rem}.home-footer p{margin:0}@media(max-width:780px){.home-shell{grid-template-columns:1fr;gap:1.5rem;padding-top:1.5rem}.profile-card{position:static}.featured-card{grid-template-columns:1fr}.featured-card img{height:180px}.post-row{grid-template-columns:76px minmax(0,1fr) auto}.post-row img{min-height:76px}.home-footer{display:block}.home-footer a{display:inline-block;margin-top:.5rem}}
</style>
