---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const allPosts = await getCollection('blog');

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const availableTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
	return availableTags.map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

const { tag } = Astro.props as { tag: string };
const posts = allPosts
	.filter((post) => post.data.tags.includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`#${tag} | ${SITE_TITLE}`} description={`${tag} 标签下的文章。${SITE_DESCRIPTION}`} />
		<style>
			main { width: min(880px, calc(100% - 2rem)); }
			header + main { padding-top: 2.25rem; }
			.eyebrow { color: rgba(124, 211, 255, 0.82); font-size: 0.9rem; font-weight: 700; }
			ul { display: grid; gap: 1rem; padding: 0; list-style: none; }
			li { padding: 1.25rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
			li a { color: rgb(var(--white)); text-decoration: none; }
			li a:hover { color: var(--accent); }
			li p { margin: 0.35rem 0 0; color: rgba(241, 245, 249, 0.66); }
			.date { font-size: 0.9rem; color: rgba(241, 245, 249, 0.52); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">标签</p>
			<h1>#{tag}</h1>
			<p>共 {posts.length} 篇文章。</p>
			<ul>
				{posts.map((post) => <li><a href={`/blog/${post.id}/`}><h2>{post.data.title}</h2><p>{post.data.description}</p><p class="date"><FormattedDate date={post.data.pubDate} /></p></a></li>)}
			</ul>
		</main>
		<Footer />
	</body>
</html>
